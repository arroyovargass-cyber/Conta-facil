# Local only. Generate actual local values with node infra/local-env.mjs.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=
LOCAL_JWT_SECRET=
SESSION_KEY=
APP_ORIGIN=http://localhost:5173
PORT=3001
NODE_ENV=development
# Hosting options (see docs/deployment/render-supabase.md):
# STATIC_DIRECTORY=dist
# TRUST_PROXY_HOPS=1
# DATABASE_CA_CERT=
# In production, APP_ORIGIN can be derived from RENDER_EXTERNAL_URL.
# SESSION_KEY accepts 32 random bytes as hex or canonical base64.

# Optional independent vault keys; absence disables credential storage. Never commit values.
# Local synthetic tests only: npm run openssl:prepare && npm run vault:local-keys
# HACIENDA_KEYRING={"key-id":"64 hexadecimal characters"}
# HACIENDA_ACTIVE_KEY_ID=key-id
HACIENDA_STAG_PROBE_ENABLED=false
HACIENDA_PRODUCTION_PROBE_ENABLED=false

# Activación independiente; revisar llave, conexión y numeración en cada ambiente.
HACIENDA_STAG_EMISSION_ENABLED=false
HACIENDA_PRODUCTION_EMISSION_ENABLED=false
# HACIENDA_SOFTWARE_PROVIDER_ID=identificacion_real_del_proveedor
# Valor anterior conservado por compatibilidad. La política official_api exige
# procedencia del GET HTTPS oficial + XSD/firma/correlación, no huella preinscrita.
HACIENDA_RESPONSE_TRUST_POLICY=pinned_certificate
# En pinned_certificate: huellas oficiales separadas, sin herencia entre ambientes.
# HACIENDA_RESPONSE_CERTIFICATE_PINS=["huella_hexadecimal_de_64_caracteres"]
# HACIENDA_PRODUCTION_RESPONSE_CERTIFICATE_PINS=["huella_oficial_de_produccion"]
# Correo del servidor: guardar secretos solamente en el entorno privado.
# SMTP_HOST=
# SMTP_PORT=465
SMTP_SECURE=true
# SMTP_FROM=
# SMTP_USER=
# SMTP_PASSWORD=
