{
  "name": "conta-facil",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"tsx watch apps/api/src/server.ts\" \"vite --config apps/web/vite.config.ts\"",
    "build": "node infra/check-inspector.mjs && tsc --noEmit && vite build --config apps/web/vite.config.ts && esbuild apps/api/src/server.ts --platform=node --format=esm --packages=external --bundle --outfile=dist-server/server.mjs && esbuild apps/api/src/security/pkcs12-worker.ts --platform=node --format=esm --bundle --outfile=dist-server/pkcs12-worker.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:db": "node infra/test-db.mjs",
    "db:start": "npm run local:up",
    "db:reset": "supabase db reset",
    "bootstrap": "tsx apps/api/scripts/bootstrap.ts",
    "local:env": "node infra/local-env.mjs",
    "local:up": "node infra/local-env.mjs && docker compose --env-file .env -f infra/compose.yml up -d",
    "local:down": "docker compose --env-file .env -f infra/compose.yml down",
    "db:migrate": "node infra/migrate.mjs",
    "format": "prettier --write apps packages tests infra/*.mjs",
    "start": "node dist-server/server.mjs",
    "test:browser": "npm run build && playwright test",
    "openssl:prepare": "node infra/prepare-openssl.mjs",
    "vault:local-keys": "node infra/local-vault-env.mjs",
    "fiscal:schemas:audit": "node --import tsx infra/audit-hacienda-schemas.ts",
    "fiscal:xml:inspect": "node --import tsx infra/inspect-invoice-xml.ts"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.5",
    "@fastify/helmet": "13.2.0",
    "@fastify/static": "10.1.10",
    "@supabase/supabase-js": "2.119.0",
    "fastify": "5.12.8",
    "lucide-react": "1.70.0",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "saxes": "6.0.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@tailwindcss/vite": "4.3.5",
    "@types/node": "26.6.6",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "concurrently": "10.0.7",
    "esbuild": "0.28.2",
    "prettier": "3.9.10",
    "supabase": "3.1.0",
    "tailwindcss": "4.3.5",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.7",
    "vitest": "5.1.0"
  },
  "engines": {
    "node": "24.x"
  }
}
